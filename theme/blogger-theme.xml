<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2'
      class='v2'
      expr:dir='data:blog.languageDirection'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'
      xmlns:data='http://www.google.com/2005/gml/data'
      xmlns:expr='http://www.google.com/2005/gml/expr'>

<head>
  <meta content='width=device-width, initial-scale=1, viewport-fit=cover' name='viewport'/>
  <meta content='IE=edge' http-equiv='X-UA-Compatible'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>
  <meta content='website' property='og:type'/>
  <meta expr:content='data:blog.title' property='og:site_name'/>
  <meta expr:content='data:blog.pageTitle' property='og:title'/>
  <meta expr:content='data:blog.url' property='og:url'/>

  <!-- External design system: stylesheets will be added as separate files in assets/css/. -->
  <link href='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/css/tokens.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/css/base.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/css/layout.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/css/components.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/css/blog.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/css/responsive.css' rel='stylesheet'/>

  <b:skin><![CDATA[
    /* Critical fallback only. The complete design system lives in external CSS files. */
    body { margin: 0; font-family: Arial, sans-serif; }
    img { max-width: 100%; height: auto; }
  ]]></b:skin>
</head>

<body>
  <div class='site-shell' id='site-shell'>

    <!-- 1. LANDING / BRAND INTRO -->
    <header class='site-header' id='top'>
      <div class='site-header__inner'>
        <div class='site-brand'>
          <b:section id='siteBrand' class='site-brand__section' maxwidgets='1' showaddelement='yes'>
            <b:widget id='Header1' type='Header' title='Site Header' locked='true' version='2'/>
          </b:section>
        </div>

        <!-- 2. NAVIGATION: configure menu items through Blogger LinkList gadget. -->
        <div class='primary-navigation' id='primary-navigation'>
          <button aria-controls='primary-navigation-panel' aria-expanded='false' aria-label='Open navigation' class='nav-toggle' type='button'>
            <span></span><span></span><span></span>
          </button>
          <div class='primary-navigation__panel' id='primary-navigation-panel'>
            <b:section id='navigationLinks' class='navigation-links' maxwidgets='1' showaddelement='yes'>
              <b:widget id='LinkList1' type='LinkList' title='Main Navigation' locked='false' version='2'/>
            </b:section>
            <div class='navigation-search'>
              <b:section id='navigationSearch' class='navigation-search__section' maxwidgets='1' showaddelement='yes'>
                <b:widget id='BlogSearch1' type='BlogSearch' title='Search this site' locked='false' version='2'/>
              </b:section>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Homepage-only landing page and personal welcome message. -->
    <b:if cond='data:view.isHomepage'>
      <main class='homepage-main' id='homepage-main'>
        <section class='landing-hero' id='landing-hero'>
          <b:section id='landingPage' class='landing-page' maxwidgets='3' showaddelement='yes'>
            <b:widget id='HTML1' type='HTML' title='Landing Page / Hero' locked='false' version='2'/>
          </b:section>
        </section>

        <!-- 4. MESSAGE: add profile image and message using an HTML gadget. -->
        <section class='welcome-message' id='welcome-message'>
          <b:section id='welcomeMessage' class='welcome-message__section' maxwidgets='2' showaddelement='yes'>
            <b:widget id='HTML2' type='HTML' title='Welcome Message' locked='false' version='2'/>
          </b:section>
        </section>

        <div class='homepage-content-grid'>
          <div class='homepage-primary-column'>
            <section class='featured-content' id='featured-content'>
              <b:section id='featuredContent' class='featured-content__section' maxwidgets='3' showaddelement='yes'>
                <b:widget id='HTML3' type='HTML' title='Featured Content' locked='false' version='2'/>
              </b:section>
            </section>
          </div>
          <aside class='site-sidebar site-sidebar--home' id='home-sidebar'>
            <b:section id='sidebarHome' class='sidebar-widgets' maxwidgets='12' showaddelement='yes'/>
          </aside>
        </div>
      </main>
    <b:else/>
      <!-- 8. BLOG POSTS / STATIC PAGES -->
      <main class='content-layout' id='content-layout'>
        <div class='main-column' id='main-column'>
          <b:section id='mainContent' class='main-content' showaddelement='no'>
            <b:widget id='Blog1' type='Blog' title='Blog Posts' locked='true' version='2'/>
          </b:section>

          <!-- 7. GADGETS INSIDE / BELOW INDIVIDUAL POSTS -->
          <b:if cond='data:view.isPost'>
            <section class='post-extras' id='post-extras'>
              <b:section id='insidePostGadgets' class='inside-post-gadgets' maxwidgets='8' showaddelement='yes'/>
            </section>
          </b:if>
        </div>

        <!-- 3. SIDEBAR -->
        <aside class='site-sidebar' id='site-sidebar'>
          <b:section id='sidebarMain' class='sidebar-widgets' maxwidgets='12' showaddelement='yes'/>
        </aside>
      </main>
    </b:if>

    <!-- 5. SUBSIDIARY WEBSITES / NETWORK -->
    <section class='subsidiary-section' id='subsidiary-section'>
      <b:section id='subsidiarySites' class='subsidiary-sites' maxwidgets='4' showaddelement='yes'>
        <b:widget id='HTML4' type='HTML' title='Other Websites / Subsidiary' locked='false' version='2'/>
      </b:section>
    </section>

    <!-- 6. POST LABELS / CATEGORIES -->
    <section class='category-section' id='category-section'>
      <b:section id='postCategories' class='post-categories' maxwidgets='2' showaddelement='yes'>
        <b:widget id='Label1' type='Label' title='Explore by Category' locked='false' version='2'/>
      </b:section>
    </section>

    <!-- 9. FOOTER / CREDIT -->
    <footer class='site-footer' id='site-footer'>
      <div class='site-footer__inner'>
        <b:section id='footerMain' class='footer-main' maxwidgets='6' showaddelement='yes'>
          <b:widget id='HTML5' type='HTML' title='Footer Information' locked='false' version='2'/>
        </b:section>
        <div class='site-footer__bottom'>
          <span class='copyright-line'>© <data:blog.title/>. All rights reserved.</span>
          <span class='theme-credit'>Designed for a professional personal brand.</span>
        </div>
      </div>
    </footer>
  </div>

  <!-- JavaScript is intentionally kept outside the XML theme and will be added as modular files. -->
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/vendor/jquery.min.js' defer='defer'></script>
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/core/dom-ready.js' defer='defer'></script>
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/modules/navigation.js' defer='defer'></script>
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/modules/search.js' defer='defer'></script>
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/modules/post-cards.js' defer='defer'></script>
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/modules/sidebar.js' defer='defer'></script>
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/modules/post-enhancements.js' defer='defer'></script>
  <script src='https://cdn.jsdelivr.net/gh/crazysuman99/ksumanadhikari-theme@main/assets/js/app.js' defer='defer'></script>
</body>
</html>